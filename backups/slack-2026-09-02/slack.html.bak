{% extends "base.html" %}
{% block title %}Slack Notifications{% endblock %}
{% block content %}
<div class="container mt-4">
    <h2 class="mb-4 text-center">Slack Notifications</h2>
    <a href="{{ url_for('settings.index') }}" class="btn btn-secondary mb-4">← Back to System Setup</a>
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
                <div class="alert alert-{{ category }}">{{ message }}</div>
            {% endfor %}
        {% endif %}
    {% endwith %}
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p class="text-muted">Messages go to one Slack channel when work is created, assigned, or completed.</p>
            <form method="POST">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="slack_enabled" name="slack_enabled" {% if enabled %}checked{% endif %}>
                    <label class="form-check-label" for="slack_enabled">Enable Slack messages</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Webhook URL</label>
                    <input type="password" class="form-control" name="slack_webhook_url" value="{{ webhook }}" placeholder="https://hooks.slack.com/services/...">
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
            <form method="POST" action="{{ url_for('settings.slack_test') }}" class="mt-3">
                <button type="submit" class="btn btn-outline-success">Send test message</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
