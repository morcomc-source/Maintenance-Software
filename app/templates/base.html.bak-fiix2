<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2.5, user-scalable=yes">
    <meta name="theme-color" content="#0d6efd">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Maintenance">
    <title>{% block title %}Maintenance{% endblock %}</title>

    <link rel="manifest" href="{{ url_for('static', filename='manifest.json') }}">
    <link rel="apple-touch-icon" href="{{ url_for('static', filename='icons/icon-192.png') }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ url_for('static', filename='icons/icon-192.png') }}">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .tabs { margin-bottom: 20px; }
        .tab-button {
            padding: 10px 20px;
            cursor: pointer;
            background: #ddd;
            border: none;
            font-size: 16px;
        }
        .tab-button.active { background: #007bff; color: white; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; cursor: pointer; }
    </style>
	<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>







<style>
@media (min-width: 992px) {
  body {
    background: #f4f6f9 !important;
  }
  .navbar, .navbar.bg-dark, .navbar-dark {
    background: #1a3a6b !important;
    box-shadow: 0 2px 6px rgba(0,0,0,.08) !important;
  }
  .navbar-brand, .nav-link {
    color: #ffffff !important;
  }

  /* All cards */
  .card {
    border-radius: 10px !important;
    border: 1px solid #e5e9ef !important;
    box-shadow: 0 1px 4px rgba(0,0,0,.05) !important;
    background: #ffffff !important;
  }
  .card-header {
    background: #f8fafc !important;
    border-bottom: 1px solid #e5e9ef !important;
    font-weight: 600 !important;
  }

  /* Dashboard stat tiles (the exact classes from admin.html) */
  .dash-stat {
    border-radius: 10px !important;
    border: 1px solid #e5e9ef !important;
    box-shadow: 0 2px 6px rgba(0,0,0,.06) !important;
    background: #ffffff !important;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .dash-stat:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0,0,0,.08) !important;
  }
  .dash-stat .stat-num {
    font-size: 2.6rem !important;
    font-weight: 700 !important;
    line-height: 1.1 !important;
    margin: 0.25rem 0 !important;
  }
  .dash-stat .text-muted.small {
    font-size: 0.8rem !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
    color: #5a6a7a !important;
  }
  .dash-stat .small.text-primary {
    font-size: 0.75rem !important;
  }

  /* Tables */
  .table thead th {
    background: #f0f4f8 !important;
    color: #1a3a6b !important;
    font-weight: 600 !important;
    border-bottom: 2px solid #d0d7e2 !important;
  }
  .table tbody tr:hover {
    background: #f8fbff !important;
  }
  .table td, .table th {
    padding: 0.75rem 1rem !important;
    vertical-align: middle !important;
  }

  /* Badges */
  .badge {
    border-radius: 12px !important;
    padding: 0.35em 0.75em !important;
    font-weight: 500 !important;
  }

  /* Spacing */
  .container, .container-fluid {
    padding-top: 1.5rem !important;
    padding-bottom: 1.5rem !important;
  }
  .dash-stat-row {
    --bs-gutter-x: 1rem;
    --bs-gutter-y: 1rem;
  }
}
</style>

</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container-fluid position-relative" style="min-height: 64px;">
        {% if current_user.is_authenticated %}
        <a class="navbar-brand position-absolute top-50 start-50 translate-middle mb-0 fs-3 fw-semibold" href="{{ url_for('dashboard.index') }}">My Maintenance Desk</a>
        <div class="ms-auto d-flex align-items-center">
            <span class="text-light small me-3 d-none d-sm-inline">{{ current_user.display_name }}</span>
            <a class="btn btn-sm btn-outline-light" href="{{ url_for('auth.logout') }}">Logout</a>
        </div>
        {% else %}
        <a class="navbar-brand position-absolute top-50 start-50 translate-middle mb-0 fs-3 fw-semibold" href="{{ url_for('auth.login') }}">My Maintenance Desk</a>
        {% endif %}
    </div>
</nav>
    <div class="container mt-4">
        {% block content %}{% endblock %}
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/serviceworker.js', { scope: '/' })
                    .catch(function (err) {
                        console.log('Service worker registration failed:', err);
                    });
            });
        }
    </script>

<div class="modal fade" id="pdf-download-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Download PDF</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">Download <strong id="pdf-download-label">this PDF</strong>?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="pdf-download-yes">Download</button>
      </div>
    </div>
  </div>
</div>
<script>
window.confirmPdfDownload = function(url, label) {
  function startDownload() {
    var a = document.createElement("a");
    a.href = url;
    a.setAttribute("download", "");
    document.body.appendChild(a);
    a.click();
    a.remove();
  }
  function clearBackdrop() {
    document.querySelectorAll(".modal-backdrop").forEach(function(el) { el.remove(); });
    document.body.classList.remove("modal-open");
    document.body.style.removeProperty("overflow");
    document.body.style.removeProperty("padding-right");
  }
  var modalEl = document.getElementById("pdf-download-modal");
  var labelEl = document.getElementById("pdf-download-label");
  var yesBtn = document.getElementById("pdf-download-yes");
  if (!modalEl || !yesBtn || typeof bootstrap === "undefined") {
    if (confirm("Download " + (label || "this PDF") + "?")) startDownload();
    return;
  }
  if (labelEl) labelEl.textContent = label || "this PDF";
  yesBtn.onclick = function() {
    var inst = bootstrap.Modal.getInstance(modalEl);
    if (inst) inst.hide();
    setTimeout(function() {
      clearBackdrop();
      startDownload();
    }, 150);
  };
  new bootstrap.Modal(modalEl).show();
};
</script>

</body>
</html>
